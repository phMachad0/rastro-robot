# If Mosquitto runs on this PC, use the host gateway. Otherwise set a broker IP
# reachable from the Docker network.
MQTT_HOST=host.docker.internal
MQTT_PORT=1883
MQTT_TOPIC=robot/telemetry
MQTT_SESSION_CONTROL_TOPIC=robot/session/control
MQTT_SESSION_STATUS_TOPIC=robot/session/status
DEVICE_ID=rastro-robot-1

INFLUX_ORG=rastro-robot
INFLUX_BUCKET=robot-telemetry
INFLUX_USER=robot-admin
INFLUX_PASSWORD=replace-with-a-local-password
INFLUX_TOKEN=replace-with-a-long-random-token
INFLUX_RETENTION=24h

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-password
